<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.uniupo.msvm.ui.controllers.MainController"
            prefHeight="600.0" prefWidth="900.0">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #ddd;">
            <Button text="▶ RUN" fx:id="btnRun" onAction="#onRun"/>
            <Button text="⏭ STEP" fx:id="btnStep" onAction="#onStep"/>
            <Button text="⏹ RESET" fx:id="btnReset" onAction="#onReset"/>
            <Separator orientation="VERTICAL"/>
            <Label text="IP:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblIp" text="0000" style="-fx-font-family: 'Monospaced';"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Stack Size:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblStackSize" text="0"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="5" style="-fx-padding: 10;">
            <Label text="System Memory (RAM)" style="-fx-font-weight: bold;"/>
            <TableView fx:id="memoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAddress" text="Address" prefWidth="100"/>
                    <TableColumn fx:id="colValue" text="Value" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <left>
        <VBox spacing="5" style="-fx-padding: 10;">
            <Label text="Source Code" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="codeEditor" prefWidth="300" VBox.vgrow="ALWAYS"
                      text="PUSH 10&#10;PUSH 20&#10;ADD&#10;HALT"/>
        </VBox>
    </left>

    <right>
        <VBox spacing="5" style="-fx-padding: 10;">
            <Label text="Operand Stack" style="-fx-font-weight: bold;"/>
            <ListView fx:id="stackList" prefWidth="150" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <bottom>
        <TextArea fx:id="consoleArea" prefHeight="100" editable="false"
                  style="-fx-control-inner-background: black; -fx-text-fill: lime;"/>
    </bottom>

</BorderPane>