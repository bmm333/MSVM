<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="main-bg" stylesheets="@login.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.uniupo.msvm.ui.controllers.RegistrazioneController">

    <VBox alignment="CENTER" maxWidth="-Infinity" prefWidth="380.0" spacing="15.0" styleClass="login-card">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <Label styleClass="title-label" text="Crea Account" />
        <Label styleClass="subtitle-label" text="Unisciti alla Community MSVM" />

        <HBox spacing="15.0">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <TextField fx:id="txtNome" promptText="Nome" styleClass="input-field" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtCognome" promptText="Cognome" styleClass="input-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <TextField fx:id="txtEmail" promptText="Email istituzionale" styleClass="input-field" />

        <PasswordField fx:id="txtPassword" promptText="Password" styleClass="input-field" />

        <PasswordField fx:id="txtConfermaPass" promptText="Conferma Password" styleClass="input-field" />

        <Label fx:id="lblErroreReg" textFill="#d32f2f" visible="false" wrapText="true" style="-fx-font-size: 12px;"/>

        <Button onAction="#handleRegistrazione" prefWidth="320.0" styleClass="login-btn" text="REGISTRATI ORA">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="5.0">
            <Label text="Hai già un account?" textFill="#777777" />
            <Button onAction="#tornaALogin" styleClass="link-btn" text="Accedi qui" />
        </HBox>

    </VBox>
</VBox>