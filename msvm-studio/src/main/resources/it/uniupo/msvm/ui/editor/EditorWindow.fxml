<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.uniupo.msvm.ui.controllers.editor.EditorController"
            stylesheets="@editor.css"
            prefHeight="720.0" prefWidth="1100.0"
            styleClass="root-pane"> <top>
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="toolbar-container">
        <Label text="MSVM Studio" styleClass="app-title"/>
        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="▶ Run" fx:id="btnRun" onAction="#onRun" styleClass="button, run-btn"/>
            <Button text="Step ⤵" fx:id="btnStep" onAction="#onStep" styleClass="button, step-btn"/>
            <Button text="Stop ■" fx:id="btnReset" onAction="#onReset" styleClass="button, reset-btn"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="15" alignment="CENTER" styleClass="status-bar">
            <HBox spacing="5">
                <Label text="IP" styleClass="status-label"/>
                <Label fx:id="lblIp" text="0000" styleClass="data-value"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="5">
                <Label text="SP" styleClass="status-label"/>
                <Label fx:id="lblStackSize" text="0" styleClass="data-value"/>
            </HBox>
        </HBox>
    </HBox>
</top>

    <center>
        <SplitPane dividerPositions="0.25, 0.75" styleClass="main-split-pane">

            <VBox styleClass="card-panel" spacing="5">
                <Label text="Source Code" styleClass="header-label"/>
                <TextArea fx:id="codeEditor" styleClass="code-area" VBox.vgrow="ALWAYS"
                          text="; Start coding...&#10;PUSH 10&#10;PUSH 20&#10;ADD&#10;HALT"/>
            </VBox>

            <VBox spacing="10">
                <VBox styleClass="card-panel" VBox.vgrow="ALWAYS">
                    <Label text="Memory Map" styleClass="header-label"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                        <content>
                            <TilePane fx:id="memoryGrid" hgap="4" vgap="4" prefColumns="24"
                                      styleClass="memory-grid-pane" />
                        </content>
                    </ScrollPane>
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="legend-container">
                        <Label text="● Code" styleClass="legend-code"/>
                        <Label text="● Data" styleClass="legend-data"/>
                        <Label text="● Empty" styleClass="legend-empty"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card-panel" prefHeight="200">
                    <Label text="Output Console" styleClass="header-label"/>
                    <TextArea fx:id="consoleArea" styleClass="console-area" editable="false"/>
                </VBox>
            </VBox>

            <SplitPane orientation="VERTICAL" dividerPositions="0.6" styleClass="inner-split">

                <VBox styleClass="card-panel">
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="OPERAND STACK" styleClass="header-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="(LIFO)" styleClass="lifo-label"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                styleClass="transparent-scroll">
                        <content>
                            <VBox fx:id="visualStackContainer" styleClass="stack-container" alignment="TOP_CENTER">
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>

                <VBox styleClass="card-panel">
                    <Label text="REGISTERS &amp; RAM" styleClass="header-label"/>
                    <TableView fx:id="memoryTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAddress" text="ADDR" prefWidth="70"/>
                            <TableColumn fx:id="colValue" text="VAL" prefWidth="70"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </SplitPane>

        </SplitPane>
    </center>

</BorderPane>